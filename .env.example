# Copy to .env for local use. Never commit real secrets.
# Render Free disk is ephemeral: SQLite, Chroma, and uploads reset on sleep/redeploy.

ENVIRONMENT=production
DATABASE_URL=sqlite:///./sql_app.db
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173

LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CHROMA_PERSIST_DIRECTORY=./storage/chroma
DOCUMENT_STORAGE_DIRECTORY=./storage/documents

PORT=8000

# Frontend (Vercel / Vite). Local fallback is http://localhost:8000
VITE_API_URL=http://localhost:8000
